generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  username     String        @unique
  name         String
  passwordHash String
  /// user | admin
  role         String        @default("user")
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  lastLoginAt  DateTime?
  boards       Board[]
  sessions     AuthSession[]
  workSessions WorkSession[]
  settings     Setting[]
  aiInsights   AiInsight[]
  aiMemory     AiMemory?
  sleepLogs    SleepLog[]
}

/// Sessão de login (o id é o token guardado no cookie)
model AuthSession {
  id        String   @id
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  userAgent String   @default("")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Board {
  id        String   @id @default(cuid())
  userId    String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lists     List[]

  @@index([userId])
}

model List {
  id       String @id @default(cuid())
  boardId  String
  name     String
  position Int    @default(0)
  /// 1 = alta, 2 = média, 3 = baixa
  priority Int    @default(2)
  /// normal | tomorrow | done
  kind     String @default("normal")
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards    Card[]

  @@index([boardId])
}

model Card {
  id               String        @id @default(cuid())
  listId           String
  title            String
  description      String        @default("")
  /// 1 = alta, 2 = média, 3 = baixa
  priority         Int           @default(2)
  position         Int           @default(0)
  estimatedMinutes Int?
  /// yyyy-MM-dd (dia para o qual a tarefa está agendada)
  scheduledFor     String
  createdAt        DateTime      @default(now())
  completedAt      DateTime?
  archivedAt       DateTime?
  list             List          @relation(fields: [listId], references: [id], onDelete: Cascade)
  sessions         TaskSession[]

  @@index([listId])
  @@index([scheduledFor])
  @@index([completedAt])
}

/// Tempo gasto em uma tarefa específica
model TaskSession {
  id        String    @id @default(cuid())
  cardId    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  card      Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

/// Sessão de trabalho (botão iniciar/parar do dashboard)
model WorkSession {
  id        String    @id @default(cuid())
  userId    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

/// Preferências por usuário (ex.: dailyGoalMinutes)
model Setting {
  userId String
  key    String
  value  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

/// Configurações globais do app (ex.: allowRegistration), editadas pelo admin
model AppSetting {
  key   String @id
  value String
}

/// Análise do dia gerada pela IA para um usuário
model AiInsight {
  id               String   @id @default(cuid())
  userId           String
  /// yyyy-MM-dd
  dayKey           String
  model            String
  /// JSON com score, headline, assessment, suggestions, nextTasks, schedule
  content          String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayKey])
}

/// Memória de hábitos do usuário, reescrita pela IA a cada análise
model AiMemory {
  userId    String   @id
  summary   String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Registro de uma noite de sono (identificada pelo dia em que acordou)
model SleepLog {
  id        String   @id @default(cuid())
  userId    String
  /// yyyy-MM-dd do dia em que acordou
  dayKey    String
  /// hora que deitou
  bedAt     DateTime
  /// hora que pegou no sono
  sleepAt   DateTime
  /// hora que acordou
  wakeAt    DateTime
  /// 1 (péssimo) a 5 (ótimo), opcional
  quality   Int?
  note      String   @default("")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
  @@index([userId, wakeAt])
}
