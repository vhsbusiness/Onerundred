generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  username     String        @unique
  name         String
  passwordHash String
  /// user | admin
  role         String        @default("user")
  active       Boolean       @default(true)
  /// Foto de perfil como data URL (JPEG pequeno), opcional
  avatar       String?
  createdAt    DateTime      @default(now())
  lastLoginAt  DateTime?
  boards       Board[]
  sessions     AuthSession[]
  workSessions WorkSession[]
  settings     Setting[]
  aiInsights   AiInsight[]
  aiMemory     AiMemory?
  sleepLogs    SleepLog[]
  projects     Project[]
  leisureLogs  LeisureLog[]
  undoActions  UndoAction[]
  pushSubs     PushSubscription[]
  notifPref    NotificationPref?
  notifLogs    NotificationLog[]
  reminders    Reminder[]
  aiUsage      AiUsage[]
  memberships  BoardMember[]
  invitesSent  BoardInvite[] @relation("InvitesSent")
  invitesGot   BoardInvite[] @relation("InvitesGot")
}

/// Sessão de login (o id é o token guardado no cookie)
model AuthSession {
  id        String   @id
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  userAgent String   @default("")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Board {
  id        String   @id @default(cuid())
  userId    String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lists     List[]
  members   BoardMember[]
  invites   BoardInvite[]

  @@index([userId])
}

/// Usuário com acesso a um quadro de outra pessoa
model BoardMember {
  id        String   @id @default(cuid())
  boardId   String
  userId    String
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}

/// Convite para participar de um quadro (aparece no sininho do convidado)
model BoardInvite {
  id          String    @id @default(cuid())
  boardId     String
  fromUserId  String
  toUserId    String
  /// pending | accepted | declined
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  from        User      @relation("InvitesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  to          User      @relation("InvitesGot", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([boardId, toUserId])
  @@index([toUserId, status])
}

model List {
  id       String @id @default(cuid())
  boardId  String
  name     String
  position Int    @default(0)
  /// 1 = alta, 2 = média, 3 = baixa
  priority Int    @default(2)
  /// normal | tomorrow | done
  kind     String @default("normal")
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards    Card[]

  @@index([boardId])
}

model Card {
  id               String        @id @default(cuid())
  listId           String
  title            String
  description      String        @default("")
  /// 1 = alta, 2 = média, 3 = baixa
  priority         Int           @default(2)
  position         Int           @default(0)
  estimatedMinutes Int?
  /// yyyy-MM-dd (dia para o qual a tarefa está agendada)
  scheduledFor     String
  createdAt        DateTime      @default(now())
  completedAt      DateTime?
  archivedAt       DateTime?
  list             List          @relation(fields: [listId], references: [id], onDelete: Cascade)
  sessions         TaskSession[]
  images           CardImage[]
  checklist        ChecklistItem[]
  postponements    CardPostponement[]
  reminders        Reminder[]

  @@index([listId])
  @@index([scheduledFor])
  @@index([completedAt])
}

/// Tempo gasto em uma tarefa específica
model TaskSession {
  id        String    @id @default(cuid())
  cardId    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  card      Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

/// Sessão de trabalho (botão iniciar/parar do dashboard)
model WorkSession {
  id        String    @id @default(cuid())
  userId    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

/// Preferências por usuário (ex.: dailyGoalMinutes)
model Setting {
  userId String
  key    String
  value  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

/// Configurações globais do app (ex.: allowRegistration), editadas pelo admin
model AppSetting {
  key   String @id
  value String
}

/// Análise do dia gerada pela IA para um usuário
model AiInsight {
  id               String   @id @default(cuid())
  userId           String
  /// yyyy-MM-dd
  dayKey           String
  model            String
  /// JSON com score, headline, assessment, suggestions, nextTasks, schedule
  content          String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayKey])
}

/// Memória de hábitos do usuário, reescrita pela IA a cada análise
model AiMemory {
  userId    String   @id
  summary   String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Registro de uma noite de sono (identificada pelo dia em que acordou)
model SleepLog {
  id        String   @id @default(cuid())
  userId    String
  /// yyyy-MM-dd do dia em que acordou
  dayKey    String
  /// hora que deitou
  bedAt     DateTime
  /// hora que pegou no sono
  sleepAt   DateTime
  /// hora que acordou
  wakeAt    DateTime
  /// 1 (péssimo) a 5 (ótimo), opcional
  quality   Int?
  note      String   @default("")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
  @@index([userId, wakeAt])
}

/// Meta do tipo "projeto": compromisso diário por N dias
model Project {
  id          String       @id @default(cuid())
  userId      String
  name        String
  description String       @default("")
  /// Obrigações diárias, uma por linha
  obligations String       @default("")
  /// yyyy-MM-dd do primeiro dia
  startDate   String
  days        Int
  createdAt   DateTime     @default(now())
  archivedAt  DateTime?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  checks      ProjectDay[]

  @@index([userId])
}

/// Marcação de um dia do projeto
model ProjectDay {
  id        String   @id @default(cuid())
  projectId String
  /// yyyy-MM-dd
  dayKey    String
  done      Boolean
  /// true quando foi marcado automaticamente como não feito na virada do dia
  auto      Boolean  @default(false)
  markedAt  DateTime @default(now())
  note      String   @default("")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, dayKey])
}

/// Bloco de lazer (ex.: jogos), de uma hora até outra
model LeisureLog {
  id        String    @id @default(cuid())
  userId    String
  /// yyyy-MM-dd do dia em que começou
  dayKey    String
  activity  String    @default("Jogos")
  startAt   DateTime
  /// null enquanto o cronômetro está rodando
  endAt     DateTime?
  note      String    @default("")
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
}

/// Imagem anexada a uma tarefa (colada ou enviada), guardada como data URL
model CardImage {
  id        String   @id @default(cuid())
  cardId    String
  data      String
  createdAt DateTime @default(now())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

/// Dia em que uma tarefa saiu da lista "Hoje" sem ser feita (realocada): conta contra a nota daquele dia
model CardPostponement {
  id        String   @id @default(cuid())
  cardId    String
  /// yyyy-MM-dd
  dayKey    String
  createdAt DateTime @default(now())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, dayKey])
}

/// Item de checklist de uma tarefa
model ChecklistItem {
  id        String   @id @default(cuid())
  cardId    String
  text      String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

/// Última(s) ação(ões) em lote do usuário, para "Desfazer última ação"
model UndoAction {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  label     String
  /// JSON com o necessário para reverter
  payload   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Inscrição de push de um aparelho/navegador do usuário
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Preferências de notificação (tudo desligado por padrão)
model NotificationPref {
  userId       String   @id
  enabled      Boolean  @default(false)
  goalReminder Boolean  @default(false)
  longWork     Boolean  @default(false)
  weekly       Boolean  @default(false)
  balance      Boolean  @default(false)
  overdue      Boolean  @default(false)
  sleepLog     Boolean  @default(false)
  reminders    Boolean  @default(false)
  /// Aviso quando a sessão de trabalho encerra sozinha (todas as tarefas de hoje feitas)
  workEnded    Boolean  @default(true)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Registro do que já foi enviado (evita repetir no mesmo dia/semana)
model NotificationLog {
  id     String   @id @default(cuid())
  userId String
  type   String
  /// chave do período: yyyy-MM-dd (dia) ou yyyy-Www (semana)
  period String
  sentAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, period])
}

/// Lembrete criado pelo usuário: vira uma notificação na hora marcada
model Reminder {
  id         String    @id @default(cuid())
  userId     String
  title      String
  note       String    @default("")
  /// próximo disparo
  at         DateTime
  /// none | daily | weekly
  repeat     String    @default("none")
  active     Boolean   @default(true)
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
  /// Tarefa associada (opcional): a notificação abre a tarefa
  cardId     String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card       Card?     @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([userId, at])
  @@index([active, at])
  @@index([cardId])
}

/// Cada chamada à IA (análise do dia, importação de print), para medir gasto por usuário
model AiUsage {
  id               String   @id @default(cuid())
  userId           String
  /// insight | import
  kind             String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
