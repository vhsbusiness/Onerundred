# Dev local (SQLite). O schema SQLite é derivado automaticamente do Postgres.
DATABASE_URL="file:./prisma/dev.db"

# Produção (Railway → serviço Postgres → variável DATABASE_URL):
# DATABASE_URL="postgresql://postgres:SENHA@postgres.railway.internal:5432/railway"

# Fuso usado para "hoje" nas tarefas (o Railway roda em UTC por padrão)
# TZ="America/Sao_Paulo"

# OpenAI (análise do dia e memória de hábitos por usuário)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
